parameters:
    level: 8
    phpVersion:
        min: 80100
        max: 80599
    paths:
        - src
        - tests
    tmpDir: var/phpstan
    reportUnmatchedIgnoredErrors: true
    ignoreErrors:
        # NamedEntity befüllt die content-Property dynamisch; sie ist erst in den Subklassen deklariert.
        -
            message: '#Access to an undefined property APIToolkit\\Contracts\\Abstracts\\NamedEntity::\$content\.#'
            path: src/Contracts/Abstracts/NamedEntity.php
        # NamedValues ist eine kovariante Collection (@template-covariant T): getEntities()/
        # filter() liefern static<T> (via new static()+@var-Cast). $values ist generisch als
        # array<int, T> typisiert (nützlicher Read-Contract), kann zur Laufzeit aber
        # Nicht-Entities enthalten (validateData-Fallback für Skalare, z. B. new StringValues('foo')).
        # Daraus folgen: die T-in-Property-Variance sowie die bewusst defensiven instanceof-/&&-Checks.
        -
            identifier: generics.variance
            path: src/Contracts/Abstracts/NamedValues.php
        -
            identifier: instanceof.alwaysTrue
            path: src/Contracts/Abstracts/NamedValues.php
        -
            identifier: booleanAnd.alwaysTrue
            path: src/Contracts/Abstracts/NamedValues.php
        -
            identifier: instanceof.alwaysTrue
            path: src/Entities/StringValues.php
